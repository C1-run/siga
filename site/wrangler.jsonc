{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siga-landing",
  "main": "src/index.jsx",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "routes": [
    { "pattern": "siga.c1.run", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "SIGA_STATS", "id": "428cd65e99ad4f4984b46d957606d361" },
    { "binding": "WAITLIST", "id": "29b38316f62b42888ae833d725d7b680" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
